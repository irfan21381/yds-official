PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/yds-eduai?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1h

# OTP Email Configuration (using Nodemailer with Gmail example)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password # For Gmail, use an App Password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-8b-8192 # Or another LLaMA 3 model

# MongoDB Atlas Vector Search Configuration
MONGODB_ATLAS_CLUSTER_NAME=your_atlas_cluster_name
MONGODB_ATLAS_DATABASE_NAME=yds-eduai
MONGODB_ATLAS_COLLECTION_NAME=embeddings